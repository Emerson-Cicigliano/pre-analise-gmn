# Copie este arquivo para .env.local e preencha. Reinicie o servidor depois de alterar.

# Google Places API (New) — obrigatória
GOOGLE_PLACES_API_KEY=

# DataForSEO — opcional: ranking real do Maps, todas as avaliações, categorias secundárias
# (login e senha da API, em https://app.dataforseo.com/api-access)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Claude — opcional: análise de avaliações e respostas com IA (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Senha de acesso ao portal. Em branco, o portal no computador abre sem senha (online sempre tem).
APP_SENHA=
